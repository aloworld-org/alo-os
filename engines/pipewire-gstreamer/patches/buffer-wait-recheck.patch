--- a/gstpipewirepool.c
+++ b/gstpipewirepool.c
@@ -256,7 +256,12 @@
     }
 
     GST_WARNING_OBJECT (pool, "failed to dequeue buffer: %s", strerror(errno));
-    g_cond_wait (&p->cond, GST_OBJECT_GET_LOCK (pool));
+    /* The sink's process notification does not hold this mutex. It can
+     * arrive after the dequeue above and before this wait. Recheck the
+     * predicate on a bounded deadline too, without taking the PipeWire loop
+     * lock in the opposite order or retaining extra private frames. */
+    g_cond_wait_until (&p->cond, GST_OBJECT_GET_LOCK (pool),
+        g_get_monotonic_time () + 100 * G_TIME_SPAN_MILLISECOND);
   }
 
   data = b->user_data;
