 /// Texture mapping of a pixman texture
 #[derive(Debug)]
 pub struct PixmanMapping(pixman::Image<'static, 'static>);
+
+impl AsRef<[u8]> for PixmanMapping {
+    fn as_ref(&self) -> &[u8] {
+        // SAFETY: The mapping owns its image, and its allocated stride covers
+        // every row. The immutable byte view cannot outlive that owner.
+        unsafe { std::slice::from_raw_parts(self.0.data().cast(), self.0.stride() * self.0.height()) }
+    }
+}
+
+impl AsMut<[u8]> for PixmanMapping {
+    fn as_mut(&mut self) -> &mut [u8] {
+        // SAFETY: Exclusive mapping access excludes every borrowed byte view.
+        // No other handle to this owned image is exposed by the mapping.
+        unsafe { std::slice::from_raw_parts_mut(self.0.data().cast(), self.0.stride() * self.0.height()) }
+    }
+}
