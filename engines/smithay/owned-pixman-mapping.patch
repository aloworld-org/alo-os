+impl PixmanRenderer {
+    /// Allocate initialized CPU storage that can be rendered and mapped in place.
+    pub fn create_owned_mapping(
+        &mut self,
+        format: DrmFourcc,
+        size: Size<i32, BufferCoords>,
+    ) -> Result<PixmanMapping, PixmanError> {
+        if size.w <= 0 || size.h <= 0 {
+            return Err(PixmanError::Unsupported);
+        }
+        let code = FormatCode::try_from(format).map_err(|_| PixmanError::UnsupportedPixelFormat(format))?;
+        let stride = ((size.w as u64 * u64::from(FormatCode::bpp(code)) + 31) / 32) * 4;
+        if stride == 0 || stride.checked_mul(size.h as u64).filter(|bytes| *bytes <= i32::MAX as u64).is_none() {
+            return Err(PixmanError::Unsupported);
+        }
+        // The existing allocator clears every pixel before any safe byte view.
+        <Self as Offscreen<Image<'static, 'static>>>::create_buffer(self, format, size).map(PixmanMapping)
+    }
+}
