# alo OS, as a machine boots it.
#
# ADR 0011: the operating system *is* an OCI image — a bootable container
# (`bootc`) on a rented, unmodified Fedora-derived base. Nothing below patches
# that base. What this file adds is three binaries of our own, three units, two
# directories, one description — the smallest image that boots and starts the
# agent service (queue item 28) — and, since ADR 0025, the pinned model runtime
# and the weights a machine arrives with, because the local model is what the
# machine arrives ready to run. There is no compositor in it, no desktop, no
# wallpaper and nothing to sign in at.
#
# Build it from the root of the repository:
#
#     docker build -f image/Containerfile -t alo-os:dev .
#
# **An image that builds is not an image that boots.** A green build says the
# binaries compiled and the files are where the units say they are; whether the
# machine comes up with alo-agentd running is a question for a virtual machine
# and then for a certified one, and `ROADMAP.md` keeps that half of the line
# empty until somebody has watched it happen.

# The versions, in one place, because every one of them is pinned on purpose.
ARG THE_BASE=quay.io/fedora/fedora-bootc:42@sha256:077182b6ba853b3348d0bede602ac30b9e6568c6422bcf0654de5af96f19b9c3
ARG THE_BUILDER=docker.io/library/ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b
ARG THE_STABLE=1.97.0
ARG THE_NIGHTLY=nightly-2026-06-01
ARG THE_LLVM=22
ARG THE_LINKER=0.11.0
ARG THE_TARGET=x86_64-unknown-linux-musl
# The model runtime (ADR 0006), as one exact version and the digest of the one
# artefact that version published. The version says what was asked for; the
# digest, checked below before anything is unpacked, says what arrived — a
# release published again under the same number becomes a failed build here,
# never a different runtime on a certified machine.
ARG THE_RUNTIME=0.34.0
ARG THE_RUNTIME_SHA256=cf95886728959aa09910bb34de5cca1cc5a8f68003b5597197d3f2c2d57c0804
# The weights a machine arrives with (ADR 0025, ADR 0007), declared here because
# **they ride on the image** rather than being fetched when somebody sets the
# machine up: a machine that fetches at setup has not arrived ready when it is
# offline at setup, and *the local model is what the machine arrives ready to
# run* is a promise about the box rather than about the network it is unpacked
# next to. What that costs is the image, and it is paid in one place: 2.23 GiB
# of weights, carried once, in a layer that changes only when this pin does.
#
# Which model is not a preference either. It is the largest entry
# `crates/alo-models/data/catalogue.toml` has that (a) somebody has actually put
# to `alo-driving` on a machine, (b) a certified ordinary business laptop — 16 GB,
# no card — can run comfortably, and (c) is under a licence that is ours to hand
# on, which matters more here than anywhere else in this repository: carrying
# weights in an image **is** redistribution, and a licence with conditions would
# attach those conditions to every holder of alo OS. `crates/alo-image` checks all
# three against the catalogue, so a model swapped in here that nobody measured
# fails a test rather than shipping.
#
# `THE_MODEL` is the catalogue's own id; `THE_MODELS_ARTEFACT` is what the
# runtime on the machine answers to, which is the catalogue's `artefact` field,
# so the entry a person reads and the name their machine knows are one string.
# The weights themselves come from the publisher's own GGUF rather than from the
# runtime's registry, because a registry tag is not a digest and this pin has to
# say what arrived.
ARG THE_MODEL=phi-3-mini-instruct
ARG THE_MODELS_QUANTISATION=Q4_K_M
ARG THE_MODELS_ARTEFACT=phi3:3.8b-mini-4k-instruct-q4_K_M
ARG THE_MODELS_WEIGHTS=https://huggingface.co/microsoft/Phi-3-mini-4k-instruct-gguf/resolve/a64113399c2f6b8ad3e11c394733a2ddadaa7f33/Phi-3-mini-4k-instruct-q4.gguf
ARG THE_MODELS_SHA256=8a83c7fb9049a9b2e92266fa7ad04933bb53aa1e85136b7b30f1b8000ff2edef

# ---------------------------------------------------------------------------
# What compiles alo OS, which is not what runs it
# ---------------------------------------------------------------------------
#
# The builder is Ubuntu and the image is Fedora, and that is a measurement
# rather than a preference. `alo-boundaryd` reaches `alo-bounding`, which builds
# a BPF programme on the way, which needs `bpf-linker` built against **the same
# LLVM the compiler emits** — LLVM 22 for the nightly this repository pins, and
# a mismatch is not a refusal but a segmentation fault inside an optimisation
# pass (`docs/quirks.md`). Fedora 42 ships LLVM 20 and no 22 at all, so a
# builder stage on the base would have to bring an LLVM of its own, which is a
# second copy of the hardest configuration in this repository.
#
# What that costs is the two glibcs not matching, and the answer is to need
# neither: the binaries are linked against musl, statically, so what is copied
# into the image below depends on nothing in it. `docs/autonomy/LOOP.md` has the
# same toolchain written down for the machine the build loop runs on.
FROM ${THE_BUILDER} AS built

ARG THE_STABLE
ARG THE_NIGHTLY
ARG THE_LLVM
ARG THE_LINKER
ARG THE_TARGET

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install --yes --no-install-recommends \
      ca-certificates curl \
      gcc libc6-dev musl-tools \
      llvm-${THE_LLVM} llvm-${THE_LLVM}-dev libpolly-${THE_LLVM}-dev \
      zlib1g-dev libzstd-dev \
 && rm -rf /var/lib/apt/lists/*

# `LLVM_PREFIX` is bpf-linker's own variable, and it is not `llvm-sys`'s
# `LLVM_SYS_<version>_PREFIX` — setting that one correctly changes nothing. The
# path is on `PATH` because the binary has to be called exactly `llvm-config`,
# and the one Ubuntu puts in /usr/bin is called `llvm-config-22`.
ENV LLVM_PREFIX=/usr/lib/llvm-${THE_LLVM}
ENV PATH=/root/.cargo/bin:/usr/lib/llvm-${THE_LLVM}/bin:${PATH}
ENV RUSTUP_HOME=/root/.rustup
ENV CARGO_HOME=/root/.cargo

# Two toolchains, and the second is not a preference either. There is no
# prebuilt `core` for `bpfel-unknown-none`, so it is compiled from source with
# `-Z build-std=core`, which is nightly-only; `crates/alo-bounding-kernel` pins
# which nightly, and `crates/alo-bounding/build.rs` starts the nested build
# inside that directory so the pin is what decides.
RUN curl --proto '=https' --tlsv1.2 --silent --show-error --fail https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain ${THE_STABLE} \
 && rustup target add ${THE_TARGET} \
 && rustup toolchain install ${THE_NIGHTLY} --profile minimal --component rust-src

RUN cargo install bpf-linker --version ${THE_LINKER} --locked \
      --no-default-features --features llvm-${THE_LLVM}

COPY . /alo-os
WORKDIR /alo-os

# The three processes this repository has, and nothing else: the rest of the
# workspace is libraries they reach, and a `--workspace` build here would
# compile every test target into an image that runs none of them.
RUN cargo build --release --target ${THE_TARGET} \
      --package alo-agentd --package alo-boundaryd --package alo-sessiond

# ---------------------------------------------------------------------------
# The model runtime, fetched pinned and checked before it is trusted
# ---------------------------------------------------------------------------
#
# Engines are configured, never patched: the runtime goes onto the image as a
# pinned upstream artefact, not as a source tree in this repository. A stage of
# its own rather than a line in the build stage, because compiling alo OS and
# fetching what it rents are different reasons to change — and a separate stage
# is cached separately, so bumping the runtime does not recompile the world.
#
# What is fetched is upstream's own release artefact for this architecture, and
# it is refused unless its sha256 is the one pinned above. The URL names the
# exact version; the digest is what makes the pin real.
FROM ${THE_BUILDER} AS runtime

ARG THE_RUNTIME
ARG THE_RUNTIME_SHA256

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates curl zstd \
 && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 --silent --show-error --fail --location \
      --output /ollama-linux-amd64.tar.zst \
      https://github.com/ollama/ollama/releases/download/v${THE_RUNTIME}/ollama-linux-amd64.tar.zst \
 && echo "${THE_RUNTIME_SHA256}  /ollama-linux-amd64.tar.zst" | sha256sum --check - \
 && mkdir /runtime \
 && zstd --decompress --stdout /ollama-linux-amd64.tar.zst | tar --extract --directory /runtime

# ---------------------------------------------------------------------------
# The weights, fetched pinned, checked before anything reads them, and imported
# into the runtime's own store
# ---------------------------------------------------------------------------
#
# A stage of its own for the runtime stage's reason, one step further on: 2.28
# GiB that changes only when the pin above changes has no business being rebuilt
# because a Rust file did.
#
# The import is done **here**, with the pinned runtime itself, rather than on the
# machine at first boot. A machine that imported its own weights the first time
# somebody signed in would be a machine whose first minutes are spent doing
# something that could have been done once, in a build, where a failure is a red
# build rather than a person watching a progress bar on a laptop. What lands on
# the image is therefore the runtime's model store, which the runtime reads and
# nothing here writes.
#
# The template is the publisher's own, from the same repository as the weights
# and under the same MIT licence: without it the runtime has no way to know where
# this model's turns begin and end, and *engines are configured, never patched*
# is exactly what a Modelfile is.
FROM ${THE_BUILDER} AS weights

ARG THE_MODELS_ARTEFACT
ARG THE_MODELS_WEIGHTS
ARG THE_MODELS_SHA256

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=runtime /runtime /runtime

# Two steps rather than one, and in this order on purpose: **nothing reads the
# file until its digest has been checked.** A fetch and an import in one command
# would be a machine that imported whatever arrived and verified it afterwards.
RUN curl --proto '=https' --tlsv1.2 --silent --show-error --fail --location \
      --output /weights.gguf "${THE_MODELS_WEIGHTS}" \
 && echo "${THE_MODELS_SHA256}  /weights.gguf" | sha256sum --check -

ENV LD_LIBRARY_PATH=/runtime/lib/ollama
ENV OLLAMA_MODELS=/models
RUN set -eu; \
    printf '%s\n' \
      'FROM /weights.gguf' \
      'TEMPLATE """<s>{{ if .Prompt }}<|user|>' \
      '{{ .Prompt }}<|end|>' \
      '{{ end }}<|assistant|>' \
      '{{ .Response }}<|end|>"""' \
      'PARAMETER stop <|endoftext|>' \
      'PARAMETER stop <|assistant|>' \
      'PARAMETER stop <|end|>' \
      'PARAMETER num_ctx 4096' \
      > /Modelfile; \
    /runtime/bin/ollama serve & \
    served=$!; \
    for _ in $(seq 1 60); do \
      /runtime/bin/ollama list >/dev/null 2>&1 && break; \
      sleep 1; \
    done; \
    /runtime/bin/ollama list >/dev/null; \
    /runtime/bin/ollama create "${THE_MODELS_ARTEFACT}" -f /Modelfile; \
    kill "${served}"; \
    test -d /models

# ---------------------------------------------------------------------------
# The machine
# ---------------------------------------------------------------------------
FROM ${THE_BASE}

ARG THE_TARGET

# The loader is in libexec because nobody runs it by hand: it is started once by
# systemd, before anybody signs in, and a person who found it on their PATH
# would have found the one privileged component alo OS has.
COPY --from=built /alo-os/target/${THE_TARGET}/release/alo-boundaryd /usr/libexec/alo-boundaryd
COPY --from=built /alo-os/target/${THE_TARGET}/release/alo-agentd /usr/bin/alo-agentd

# The opener is in libexec beside the loader, and for the same reason: nobody
# runs it by hand. It is started once by systemd, it opens one door, and a person
# who found it on their PATH would have found the thing that turns a number into
# a session (ADR 0024).
COPY --from=built /alo-os/target/${THE_TARGET}/release/alo-sessiond /usr/libexec/alo-sessiond

# The model runtime (ADR 0006, pinned above; ADR 0025 is why it is aboard at
# all): the binary and the libraries it loads, exactly as upstream lays them
# out. How the runtime is spoken to stays `crates/alo-models/src/ollama.rs`'s
# alone; where its files land is this image's own fact, and
# `crates/alo-image` checks it beside everything else here.
COPY --from=runtime /runtime/bin/ollama /usr/bin/ollama
COPY --from=runtime /runtime/lib/ollama/ /usr/lib/ollama/

# The weights, as the runtime's own store, already imported (ADR 0025, ADR
# 0007). This is the half that makes *the local model is what the machine
# arrives ready to run* about a disk rather than about a download.
#
# **Still no unit and nothing that starts it.** A runtime alone answers nothing
# (ADR 0019) and a runtime with weights on the disk answers nothing either until
# something starts it — which login it runs as, which group may reach its socket
# and what it may reach off this machine are a decision of their own, and this
# image does not smuggle them in beside a `COPY`.
#
# The modes are the store's own, made by root in the stage above with the
# build's umask: readable by everybody, written by nobody. They are not chmod'ed
# here the way the binaries below are, and that is deliberate — a recursive
# chmod over 2.23 GiB writes a second copy of every one of those bytes into
# another layer, and nothing about a `COPY` out of a build stage carries the
# Windows checkout's invented permission bits that the chmod exists for.
COPY --from=weights /models/ /usr/share/alo/models/

# How this image becomes a disk a machine boots, said by the image itself.
#
# There is no second recipe and no partitioner of ours: the disk is written by
# the `bootc` **inside the base pinned above**, so the version of the tool is
# `THE_BASE`'s digest and there is nothing else to pin. `docs/booting.md` is the
# command a person types, and `crates/alo-image` holds that document and these
# three lines to each other — a document that tells somebody to select the
# firmware this image is not installed for is a machine that does not boot and a
# repository that believed it did.
#
# They are labels rather than a file beside this one because they travel with
# the image: somebody holding only the image can ask it what disk it expects,
# and an image and its disk declaration cannot be separated to drift apart.
LABEL alo.disk.tool="bootc install to-disk"
LABEL alo.disk.firmware="uefi"
LABEL alo.disk.file="alo-os.raw"

COPY image/usr/lib/systemd/system/ /usr/lib/systemd/system/
COPY image/usr/lib/sysusers.d/ /usr/lib/sysusers.d/
COPY image/usr/lib/tmpfiles.d/ /usr/lib/tmpfiles.d/
COPY image/etc/alo/ /etc/alo/

# The modes are set rather than inherited. A `COPY` carries whatever the machine
# the build ran on had, and this repository is checked out on Windows as often
# as not — where a file's group and world bits are an invention of the driver.
# The description in particular is checked by `alo-agentd` before it is parsed:
# a group-writable one is a description the group writes this machine with, and
# the service refuses to start rather than believe it.
RUN chmod 0755 /usr/libexec/alo-boundaryd /usr/libexec/alo-sessiond \
               /usr/bin/alo-agentd /usr/bin/ollama \
 && chmod 0644 /usr/lib/systemd/system/alo-boundaryd.service \
               /usr/lib/systemd/system/alo-agentd.service \
               /usr/lib/systemd/system/alo-sessiond.service \
               /usr/lib/sysusers.d/alo.conf \
               /usr/lib/tmpfiles.d/alo.conf \
               /etc/alo/agentd.toml \
 && chown root:root /etc/alo/agentd.toml \
 && systemctl enable alo-boundaryd.service alo-agentd.service alo-sessiond.service \
 && bootc container lint

# The logins, made here rather than only at boot — and then checked, which is
# the point of doing it here at all.
#
# `systemd-sysusers` does not fail on a number somebody else has. It says so in
# one line of a build log and creates the login with a different number, or puts
# it in the group that already holds the one it was asked for: on this very base
# the 989 every example in this repository uses is systemd-resolve's group, and
# the first build of this image quietly put alo OS's agent in it.
#
# So the numbers are asserted. A base update that takes one of them fails the
# build with the number in front of somebody, instead of shipping a machine
# whose description names a login that is not there.
RUN systemd-sysusers \
 && test "$(id -u alo)" = 1000 \
 && test "$(id -u alo-agent)" = 60989 \
 && test "$(getent group alo-agent | cut -d: -f3)" = 60989 \
 && test "$(id -u alo-greeter)" = 60990 \
 && test "$(getent group alo-greeter | cut -d: -f3)" = 60990 \
 && id -nG alo | tr ' ' '\n' | grep -qx alo-agent
