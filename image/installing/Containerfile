# The boot environment that installs alo OS — the installer's reboot half.
#
# ADR 0023 §2–3: the program a person downloads stages *a minimal boot
# environment and a UEFI boot entry*, restarts, and that environment pulls alo
# OS from the registry, *verifying signatures before writing*. This recipe builds
# that environment, and what it produces is not an image anybody runs: it is a
# directory of files for a FAT partition.
#
#     EFI/BOOT/BOOTX64.EFI            the base's own signed shim
#     EFI/BOOT/grubx64.efi            the base's own signed loader
#     EFI/BOOT/mmx64.efi              the base's own key manager, which shim expects beside it
#     EFI/BOOT/grub.cfg               image/installing/grub.cfg
#     EFI/alo-installing/vmlinuz      the base's own signed kernel
#     EFI/alo-installing/initramfs.img
#
# Build it from the root of the repository:
#
#     podman build -f image/installing/Containerfile \
#       --output type=local,dest=alo-installing .
#
# **It is not a second operating system.** A kernel and an initramfs, both made
# from THE_BASE below by the base's own tools; in the initramfs, the programs
# `bootc install` runs, the checker for the owner's signature, the network
# manager, and `alo-installing` — one unit, no login and no shell anybody is
# offered. That unit runs under a root of its own, the environment bound again
# (`run-alo-installing-root.mount`), because the sandbox `bootc install` starts
# the boot loader's installer in cannot pivot from the initramfs's own root. `crates/alo-installing`'s tests hold `alo-installing.conf` to every
# program that crate runs.
#
# **Secure Boot is respected, never switched off** (ADR 0033 §4): the shim, the
# loader and the kernel are the base's own signed files, copied and never
# rebuilt. The initramfs is ours and is not signed, which is what the base's own
# loader already accepts from every Fedora machine's `/boot`.
#
# **What it installs and whose signature it accepts are built in.** The pin and
# the public key are copied from this repository; nothing about either can
# arrive over the network, and `crates/alo-image` holds this file to both.

# The versions, in one place. The base, the builder, the compiler and its target
# are the operating system's own — `crates/alo-image` fails a build of this
# repository where any of the four differs from `image/Containerfile`, because an
# environment on another base would be installing with a tool nobody pinned.
ARG THE_BASE=quay.io/fedora/fedora-bootc:42@sha256:077182b6ba853b3348d0bede602ac30b9e6568c6422bcf0654de5af96f19b9c3
ARG THE_BUILDER=docker.io/library/ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b
ARG THE_STABLE=1.97.0
ARG THE_TARGET=x86_64-unknown-linux-musl
# The checker for the owner's signature (ADR 0036). Fedora 42 does not package
# it, so it is upstream's own release artefact, pinned the way the model runtime
# is: an exact version, and the digest of the one file that version published,
# checked before anything runs it. The version is the one the owner verified
# release 0.0.1 with, on 2026-09-15.
ARG THE_CHECKER=3.1.3
ARG THE_CHECKERS_SHA256=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71

# ---------------------------------------------------------------------------
# The one program of ours
# ---------------------------------------------------------------------------
#
# Statically linked against musl for `image/Containerfile`'s reason: what is
# copied into the environment depends on nothing in it. No nightly and no BPF
# linker — `alo-installing` reaches neither.
FROM ${THE_BUILDER} AS built

ARG THE_STABLE
ARG THE_TARGET

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install --yes --no-install-recommends \
      ca-certificates curl gcc libc6-dev musl-tools \
 && rm -rf /var/lib/apt/lists/*

ENV PATH=/root/.cargo/bin:${PATH}
ENV RUSTUP_HOME=/root/.rustup
ENV CARGO_HOME=/root/.cargo

RUN curl --proto '=https' --tlsv1.2 --silent --show-error --fail https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain ${THE_STABLE} \
 && rustup target add ${THE_TARGET}

COPY . /alo-os
WORKDIR /alo-os

RUN cargo build --release --target ${THE_TARGET} --package alo-installing

# ---------------------------------------------------------------------------
# The checker, fetched pinned and checked before it is trusted
# ---------------------------------------------------------------------------
FROM ${THE_BUILDER} AS checker

ARG THE_CHECKER
ARG THE_CHECKERS_SHA256

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 --silent --show-error --fail --location \
      --output /cosign \
      https://github.com/sigstore/cosign/releases/download/v${THE_CHECKER}/cosign-linux-amd64 \
 && echo "${THE_CHECKERS_SHA256}  /cosign" | sha256sum --check - \
 && chmod 0755 /cosign

# ---------------------------------------------------------------------------
# The environment, made by the base's own tools
# ---------------------------------------------------------------------------
FROM ${THE_BASE} AS environment

ARG THE_TARGET

COPY --from=checker /cosign /usr/bin/cosign
COPY --from=built /alo-os/target/${THE_TARGET}/release/alo-installing /usr/bin/alo-installing

# What it installs, and the one key it accepts, at the paths
# `alo_installing::WHERE_IT_IS` reads them from — the same relative paths they
# have beside this directory.
COPY image/pinned.toml /usr/lib/alo/installing/pinned.toml
COPY image/signing/alo-os.pub /usr/lib/alo/installing/signing/alo-os.pub

# **What a wireless join needs, which the pinned base does not have.**
#
# The environment is built `FROM ${THE_BASE}` and installed nothing until now,
# so what it could carry was whatever Fedora's bootc base happens to ship. On
# 2026-10-20 that base was unpacked and listed, 145,474 paths, with a control:
# `/usr/bin/nm-online`, which this environment already runs, is there. Against
# that control, **none** of the supplicant, its unit, its bus files,
# NetworkManager's Wi-Fi plugin, any `iwlwifi` firmware or the regulatory
# database is in the base. `nmcli`, `dbus-broker` and all five wireless kernel
# modules are.
#
# So the environment could only ever have brought up a cable, and
# `docs/features.md` promises *download, click, reboot, sign in* with no cable
# in it, to an audience of developers most of whom have none.
#
# **`wireless-regdb` is asked for by name rather than taken.** The installed
# image has `regulatory.db` without naming it, as something's weak or hard
# dependency. A recipe that inspects what it asked for learns nothing — this
# file's own rule — and without that database a card falls back to the most
# restrictive domain, where association on some channels does not happen and
# the person is told *no networks found*.
#
# **The supplicant is RUN, not found.** `test -x` is the substitution
# `image/Containerfile` records twice: a binary that cannot resolve its
# libraries passes it. `-v` loads it, resolves them, prints its version and
# exits 0; with no arguments it exits 255. The prefix is grepped, not a
# version, because the version is the base's to change.
RUN dnf install --assumeyes --setopt=install_weak_deps=False \
      NetworkManager-wifi wpa_supplicant wireless-regdb \
      iwlwifi-mvm-firmware iwlwifi-dvm-firmware \
 && dnf clean all \
 && /usr/sbin/wpa_supplicant -v | grep -q 'wpa_supplicant v' \
 && ls /usr/lib64/NetworkManager/*/libnm-device-plugin-wifi.so > /dev/null \
 && test -f /usr/lib/firmware/iwlwifi-3168-29.ucode.xz \
 && test -f /usr/lib/firmware/regulatory.db \
 && echo "the environment can join a wireless network: a supplicant that runs, NetworkManager's Wi-Fi plugin, the certified machine's own firmware and the regulatory database"

COPY image/installing/alo-installing.target /usr/lib/systemd/system/alo-installing.target
COPY image/installing/alo-installing.service /usr/lib/systemd/system/alo-installing.service
COPY image/installing/run-alo-installing-root.mount /usr/lib/systemd/system/run-alo-installing-root.mount
COPY image/installing/run-alo-installing-root.mount /usr/lib/systemd/system/run-alo-installing-root.mount
COPY image/installing/alo-installing.conf /etc/dracut.conf.d/alo-installing.conf
COPY image/installing/grub.cfg /environment/EFI/BOOT/grub.cfg

# **The initramfs is held to its own list** — the check this recipe has never
# had, and the reason every path in that list was found one refusal at a time by
# restarting a machine.
#
# **Measured in the pinned base on 2026-10-20: `dracut` exits 0 for an
# `install_items` path it cannot find.** It prints nothing a build reads, writes
# the initramfs without that file, and returns success. So every entry in
# `alo-installing.conf` could be wrong — misspelt, moved by an upstream, or
# never in the base at all — and this build would be green, which is how two
# entries (`/etc/containers/containers.conf` and `storage.conf`) sat in that
# list from the day it was written without ever being in an initramfs.
#
# What this asks of the artefact rather than of the inputs:
#
# - every `install_items` path is **inside the initramfs it just built**;
# - a path that is a symlink counts when its target is aboard, because
#   `/usr/sbin` is a link to `bin` on Fedora 42 and `dracut` stores the real
#   name — the same trap as the firmware link, in the other direction;
# - a **pattern** that matches nothing on the machine fails here rather than
#   expanding to itself and quietly being absent. There is one pattern, and it
#   is NetworkManager's plugin, whose directory is named for a version `dnf`
#   chooses at build time;
# - every `add_drivers` module has a `.ko` aboard, because an initramfs with no
#   `iwlwifi` finds no card and tells the person *no networks found*.
#
# Proved both ways in the pinned base on 2026-10-20, four runs: it passes
# against the initramfs the list built; it names exactly the six wireless parts
# when they are commented out of the list the initramfs was built from; it names
# the three `iwl*` modules when `add_drivers` is; and it refuses the pattern when
# nothing matches it.

# One kernel, asserted rather than assumed: a base carrying two would make the
# choice of which one boots a directory listing's order.
RUN chmod 0755 /usr/bin/cosign /usr/bin/alo-installing \
 && chmod 0644 /usr/lib/alo/installing/pinned.toml \
               /usr/lib/alo/installing/signing/alo-os.pub \
               /usr/lib/systemd/system/alo-installing.target \
               /usr/lib/systemd/system/alo-installing.service \
               /usr/lib/systemd/system/run-alo-installing-root.mount \
               /etc/dracut.conf.d/alo-installing.conf \
               /environment/EFI/BOOT/grub.cfg \
 && test "$(ls /usr/lib/modules | wc -l)" = 1 \
 && kernel="$(ls /usr/lib/modules)" \
 && mkdir -p /environment/EFI/alo-installing \
 && dracut --no-hostonly --reproducible --force --kver "${kernel}" \
      /environment/EFI/alo-installing/initramfs.img \
 && cp "/usr/lib/modules/${kernel}/vmlinuz" /environment/EFI/alo-installing/vmlinuz \
 && list=/etc/dracut.conf.d/alo-installing.conf \
 && inside="$(lsinitrd /environment/EFI/alo-installing/initramfs.img \
      | awk 'NF == 0 { next } NF > 2 && $(NF-1) == "->" { print $(NF-2); next } { print $NF }')" \
 && absent="" \
 && for pattern in $(sed -n 's/^install_items+="\(.*\)"[[:space:]]*$/\1/p' "${list}"); do \
      for part in ${pattern}; do \
        case "${part}" in \
          *'*'*) echo "nothing in this image matches ${pattern}" >&2; exit 1 ;; \
        esac; \
        test -e "${part}" || { absent="${absent} ${part}(not-in-the-image)"; continue; }; \
        printf '%s\n' "${inside}" | grep -qxF "${part#/}" && continue; \
        real="$(readlink -f "${part}")"; \
        printf '%s\n' "${inside}" | grep -qxF "${real#/}" && continue; \
        absent="${absent} ${part}"; \
      done; \
    done \
 && for driver in $(sed -n 's/^add_drivers+="\(.*\)"[[:space:]]*$/\1/p' "${list}"); do \
      printf '%s\n' "${inside}" | grep -qE "/${driver}\.ko" \
        || absent="${absent} ${driver}.ko"; \
    done \
 && if test -n "${absent}"; then \
      echo "the initramfs does not carry what its list names:${absent}" >&2; \
      exit 1; \
    fi \
 && echo "the initramfs carries every path and every module its list names" \
 && cp /usr/lib/bootupd/updates/EFI/fedora/shimx64.efi /environment/EFI/BOOT/BOOTX64.EFI \
 && cp /usr/lib/bootupd/updates/EFI/fedora/grubx64.efi /environment/EFI/BOOT/grubx64.efi \
 && cp /usr/lib/bootupd/updates/EFI/fedora/mmx64.efi /environment/EFI/BOOT/mmx64.efi

# ---------------------------------------------------------------------------
# What leaves the build: the files for the partition, and nothing else
# ---------------------------------------------------------------------------
FROM scratch
COPY --from=environment /environment/ /
