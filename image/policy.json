{
  "default": [
    {
      "type": "reject"
    }
  ],
  "transports": {
    "docker": {
      "ghcr.io/aloworld-org/alo-os": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/etc/containers/alo-os.pub",
          "signedIdentity": {
            "type": "matchRepository"
          }
        }
      ]
    },
    "containers-storage": {
      "": [
        {
          "type": "insecureAcceptAnything"
        }
      ]
    },
    "oci": {
      "": [
        {
          "type": "insecureAcceptAnything"
        }
      ]
    }
  }
}
