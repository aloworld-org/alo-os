# alo OS: where the desktop's password sheet has a password checked
# (ADR 0150).
#
# The owner, 2026-11-09: "Yes, alo's desktop draws it". polkit asks the
# desktop to authenticate the person; an authentication agent does that by
# running polkit's own setuid helper, `polkit-agent-helper-1`. The desktop runs
# with no capability and no new privileges (`alo-desktop@.service`), so the
# helper could do nothing for it. It connects here instead, and systemd starts
# the helper as root for that one connection.
#
# **Anybody may connect, and nobody can be checked as anybody else.**
# `alo-checking-a-password` runs the helper for the login the kernel says is on
# the other end, and refuses the agent's login and every service's. The
# password goes from the desktop to the helper; nothing of alo's reads it.
[Unit]
Description=alo OS: where the desktop's password sheet has a password checked
Documentation=https://github.com/aloworld-org/alo-os/blob/main/docs/decisions/0150-administrator-actions-ask-the-persons-password-each-time.md

[Socket]
ListenStream=/run/alo-checking-a-password.socket
SocketUser=root
SocketGroup=root
SocketMode=0666
Accept=yes

[Install]
WantedBy=sockets.target
