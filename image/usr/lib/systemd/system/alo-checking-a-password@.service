# alo OS: polkit's own helper, for the caller's own login (ADR 0150).
#
# One instance per connection to `alo-checking-a-password.socket`. It becomes
# /usr/lib/polkit-1/polkit-agent-helper-1 for the login SO_PEERCRED names, with
# the connection as its standard input and output; the helper reads polkit's
# cookie, asks PAM (`/usr/lib/pam.d/polkit-1`), and tells polkit the answer.
#
# **Root, and what PAM needs to read the system's list.** The helper refuses to
# run unless its effective number is 0, and polkit takes its answer from root.
# `CAP_DAC_OVERRIDE` and `CAP_DAC_READ_SEARCH` read /etc/shadow;
# `CAP_AUDIT_WRITE` is what PAM writes its audit line with. Not measured: this
# set against the base's PAM stack and SELinux policy on a booted machine.
#
# **`CAP_SETUID`, for one call: the helper's real number becomes the
# person's.** polkit takes the helper's answer only for an agent its *real*
# number registered: the helper sends `getuid()`, and polkitd matches it
# against the agent's owner, which is the person. Run as root, the helper sent
# 0, and polkitd answered *No session for cookie* to a right password —
# measured once on 2026-11-09 in `localhost/alo-os:dev`
# (`docs/quirks/polkit-takes-the-helpers-answer-only-from-the-agents-owner.md`).
# The program sets its real number to the caller's and keeps 0 as its
# effective one, which is how the helper runs under every other desktop's
# agent, setuid from the person's own process.
[Unit]
Description=alo OS: check one password with polkit's own helper
Documentation=https://github.com/aloworld-org/alo-os/blob/main/docs/decisions/0150-administrator-actions-ask-the-persons-password-each-time.md
Requires=alo-checking-a-password.socket

[Service]
Type=exec
ExecStart=/usr/libexec/alo-checking-a-password
StandardInput=socket
StandardOutput=socket
StandardError=journal
User=root
Group=root
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_AUDIT_WRITE CAP_SETUID
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_AUDIT_WRITE CAP_SETUID
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
