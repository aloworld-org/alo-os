[Unit]
# The screen a machine boots to, and the reason an installed alo OS has stopped
# being a console.
#
# `crates/alo-shell` had every part of the sign-in screen — its keys, its
# drawing, the session it hands over to — and no binary, so nothing a machine
# could start put them in order. `alo-compositor` is that order, and this unit
# is what starts it. Until both existed, task 6 of the installer plan reached
# `alo-agentd` on a console and stopped there, and every promise in
# `docs/autonomy/evidence-a-person-can-work-on-it-all-day.md` owed to "a screen" was owed to a screen that
# did not come up.
Description=alo OS sign-in screen: the compositor a machine boots to
Documentation=https://github.com/aloworld-org/alo-os/blob/main/docs/decisions/0024-what-a-person-signs-in-at.md

# It takes a card from the login seat through libseat, and this image ships no
# seatd — nothing installs one — so the seat comes from logind.
#
# **`After=` was not enough, and this comment used to say it was.** It read *the
# seat comes from logind, which must be answering before the card is asked for*,
# and that premise is false: ordering is not membership. libseat asks logind
# which session the calling process belongs to, and **a system service belongs
# to none**, so logind answered, the card was asked for, and the answer was
# `display session connect failed: Function not implemented` — ENOSYS, which
# from libseat means *no backend at all*. Measured on a written disk on
# 2026-10-05, four restarts out of four, on a machine that was otherwise up.
#
# `PAMName=` below is what makes the process a member rather than a latecomer.
After=systemd-logind.service

[Service]
Type=exec

# **Three things differ from machine to machine, and the process refuses to
# start without them** (v0-01-delivery-plan, task 38's binary): they are lines
# here rather than guesses in the code, because a compositor that guessed any of
# them would be guessing about the display a person looks at, the account they
# sign in to, or the letters their password is made of.
#
# `ALO_PERSON` is the uid `/etc/alo/agentd.toml` names, and `crates/alo-image`
# holds this line to that file — the same way it holds the other five units to
# what they claim. A uid typed here that the machine does not have is a screen
# nobody can sign in to.
# **The virtual console the sign-in screen lives on**, and it is not cosmetic.
# `pam_systemd` reads `PAM_TTY`, which systemd fills from this line, and a
# session with no TTY is given no seat: `logind` answered
# `seat= vtnr=0` and `libseat` had nothing to take a card from. With it, the
# same machine answered `seat=seat0 vtnr=1`. Measured on a written disk,
# 2026-10-05.
TTYPath=/dev/tty1

# **`ALO_DISPLAY` is deliberately not set here, and used to be.**
#
# It read `/dev/dri/card0`, on the same reasoning as the two lines below: a
# machine says what it is rather than the code guessing. But a card *number*
# is not a fact about a machine. Firmware that hands over a framebuffer gives
# `simpledrm` minor 0, so the real GPU is minor 1 — and on 2026-10-05 this
# unit asked `seat0` for `card0` while `logind` had put `card1` on it, and the
# seat answered *No such file or directory*. Most UEFI machines hand over a
# framebuffer, so most machines would have failed this way.
#
# The compositor now asks the seat, taking the device udev marks as the boot
# VGA. The variable is still read where somebody sets it, because it is a
# public configuration key; nothing in this image sets it.
Environment=ALO_PERSON=1000
Environment=ALO_KEYBOARD=gb

# `RUNTIME_DIRECTORY` is systemd's own variable and not one of ours; the process
# reads it to find where to bind. 0700 because the socket refuses a runtime
# directory anybody else can read — a sign-in screen whose socket a second
# process could reach is a sign-in screen that is not one.
RuntimeDirectory=alo-compositor
RuntimeDirectoryMode=0700

# **The stack that makes this process a member of a logind session**, which is
# what gives libseat a seat to hand over. `image/usr/lib/pam.d/alo-compositor`
# is the file, it is in `/usr/lib` beside the base's own `systemd-run0` and
# `systemd-user` rather than in `/etc`, and it authenticates nobody: a person's
# password is `alo-accounts`' and the session they get is `alo-sessiond`'s.
#
# The owner chose this over shipping `seatd` on 2026-10-05: it configures an
# engine that is already here rather than adding a second seat manager to a
# machine that already runs logind.
PAMName=alo-compositor

# Root, because a card comes from the login seat and logind decides that on a
# privileged caller, and because the sign-in screen exists before anybody is
# signed in and so cannot be anybody. And the greeter's group, for the door:
# `TheOpenersDoor::on_this_machine` is handed to whatever group this process is
# in, which is how the surface that holds nothing is let in to knock at
# `alo-sessiond` at all. A `Group=` line naming root would open a door only root
# could reach, which is a machine nobody can sign in to.
User=root
Group=alo-greeter

# **Whatever holds the privilege holds nothing else**, which is the check task
# 38's acceptance asked for and could not make without a unit to make it about.
# This process needs a seat and a socket; it needs no capability at all, and
# saying so here is what makes that a fact rather than a sentence.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ExecStart=/usr/bin/alo-compositor

# A machine whose screen died should get its screen back rather than a console.
# `Restart=on-failure` and not `always`: somebody signing in successfully is how
# this process ends, and restarting after that would put the sign-in screen back
# over the session it just opened.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
