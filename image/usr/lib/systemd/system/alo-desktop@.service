[Unit]
# **The screen a person arrives at, and the unit task 39 was owed.**
#
# `alo-compositor` is the machine's half of the morning: the sign-in screen,
# standing in front of somebody who has not signed in, ending when a session
# opens. This is the person's half. They are two programs because they belong to
# two different people, which is `the-executable-plan.md` task 39's own
# wording — *a second program rather than a mode of the greeter*.
#
# **Until this file existed, a booted machine signed somebody in and showed them
# nothing.** `alo-desktop` was built by `image/Containerfile:374` and installed
# by `:302`, and no unit started it: 8 `ExecStart=` lines in this directory and
# none naming it. The greeter printed *this process has nothing yet to draw in
# it* and returned success, which is honest and is not a desktop.
Description=alo OS desktop: the dock, the status area and what is leaving
Documentation=https://github.com/aloworld-org/alo-os/blob/main/docs/decisions/0024-what-a-person-signs-in-at.md

# **Started by `alo-sessiond`, once a person has signed in, and by nothing else**
# (ADR 0141). The instance is their account number, and there is no `[Install]`
# section, so nothing can enable it.
#
# **This was `alo-desktop.service`, started by `WantedBy=user@1000.service`,
# until 2026-10-30**, and a booted machine showed what that cost: the person's
# manager is in no login session, so the desktop it started was in none either,
# and restart, power off and the time zone asked for a password nothing on the
# screen could take. Now this unit's own PAM stack opens the person's session
# and pid 1 moves this process into it — measured inside the image that day:
# a unit with `User=` and `PAMName=` lands in `session-N.scope`. The person's
# manager is started by that session rather than the other way round.

# **The display is handed over by `logind`, not by ordering.** This unit's
# session is made on `seat0` and becomes the seat's active session; `logind`
# then pauses the sign-in screen's devices, and the sign-in screen steps aside
# and exits (#1029). No `After=` can make that true and none is needed.

# **When the desktop ends, the sign-in screen comes back.** Signing out is the
# desktop exiting cleanly. A crash restarts it below; one that keeps crashing
# runs out of the limit here, fails, and puts the sign-in screen up rather than
# leaving a console.
OnSuccess=alo-compositor.service
OnFailure=alo-compositor.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# It stays, and the desktop stays with it. A oneshot would draw one frame.
Type=exec

# **No `Delegate=` any more, and `try` still has somewhere to make a box.**
#
# This line made the desktop's cgroup the person's, so `alo-try` could make a
# box as a child of its own cgroup (ADR 0064, measured 2026-10-18). The desktop
# now lives in the person's session scope, which is `logind`'s and root's
# whatever this unit says — measured inside the image on 2026-10-30, with and
# without a `Delegate=` drop-in for session scopes: `mkdir` answered
# *Permission denied* both times. So `alo-try` asks the person's own manager for
# a delegated scope of its own when its cgroup is not theirs, which measured
# `aloprobe:aloprobe`, type `domain`, and a move that succeeded.

# **The person, not root, and the person this instance was started for.** The
# greeter is the machine's and runs as root because a seat lends a card to a
# privileged caller before anybody is there; this is the person's own desktop
# and runs as them. `%i` is their account number, which `alo-sessiond` checked
# against the accounts file before starting this, and pid 1 becomes them before
# anything here runs. `alo-desktop`'s own header is explicit that the uid is not
# a variable it reads — *whose session this is, is whose session this is*.
User=%i

# **The seat, which is the whole reason this unit has a PAM stack.**
# `image/usr/lib/pam.d/alo-desktop` records why at length: `libseat` asks
# `logind` which session the calling process belongs to, a service belongs to
# none, and this image ships no `seatd`. `pam_systemd.so` registers the process
# with logind and the seat follows.
#
# `TTYPath=` is not cosmetic and the greeter's unit has the measurement:
# `pam_systemd` reads `PAM_TTY`, which systemd fills from this line, and a
# session with no TTY is given **no seat** — `logind` answered `seat= vtnr=0`.
# With it, the same machine answered `seat=seat0 vtnr=1`.
TTYPath=/dev/tty1
PAMName=alo-desktop

# **A person's session, said rather than defaulted**, and a Wayland one. With a
# terminal `pam_systemd` would choose `user` anyway; naming it means a later
# edit cannot quietly make this a greeter's or a background session, which
# polkit would not treat as somebody at the machine.
Environment=XDG_SESSION_CLASS=user
Environment=XDG_SESSION_TYPE=wayland

# **No card is named here, and one used to be.**
#
# This read `Environment=ALO_DISPLAY=/dev/dri/card0` under a comment saying
# that line is wrong on most machines — firmware that hands over a framebuffer
# gives `simpledrm` minor 0, so the real GPU is minor 1, and on 2026-10-05 a
# written disk answered *No such file or directory* when the greeter's unit
# made the same assumption. **Most UEFI machines hand over a framebuffer.**
#
# It was left in because the fix lived in `crates/alo-desktop`, another lane's
# crate. That was a default chosen in the knowledge that it is usually wrong,
# documented rather than fixed — which is not what `docs/quirks.md` is for: a
# quirk is reality disagreeing with a specification, not a choice we made
# against the fleet to suit the one machine it was measured on.
#
# `alo-desktop` now asks the seat, through `alo_shell::the_card_to_open` —
# the greeter's own answer, moved into the crate they both already depend on
# so that there is one of it rather than two. `ALO_DISPLAY` is still honoured
# where somebody sets it, because it is a public configuration key; nothing in
# this image sets it.

# **A fallback since 2026-10-14, not the answer.** This line was the only
# thing this binary read, and a booted machine showed what that costs: a
# person chose Français at the language sheet, the compositor said *the
# keyboard is now fr*, and the desktop went up on gb one line later. It now
# reads `/etc/alo/keyboards.toml` first — the file the language sheet writes —
# and falls back to this only on a machine where nobody has chosen yet.
#
# Kept rather than deleted for that reason: deleting it would leave a fresh
# machine with no layout at all, which is a desktop that refuses to start.
# It is the same shape as ALO_DISPLAY above, one paragraph on: honoured
# where it is set, and no longer the machine making the decision.

Environment=ALO_KEYBOARD=gb

# **The agent this machine has, by the name its grants use.** Settings needs it
# to write the grant a person makes by picking a folder, and it has to be the
# exact name `/etc/alo/agentd.toml` carries: a grant under any other name is one
# `alo-agentd` will never match, so a person would walk through choosing a
# folder and be handed nothing.
#
# **One source of truth, and it is checked rather than trusted.** The
# description is the source and this line is a copy, so the image build asserts
# that the two agree. Where this is unset Settings offers no way to give a
# folder at all — that window's rule for a setting with no road is absent rather
# than there and broken.
#
# **Handed over here rather than read from the description by the desktop**, and
# that was measured rather than preferred. Reading it through the crate that
# owns that file makes this binary depend on `alo-agentd`, which depends on
# `alo-bounding`, whose build compiles the kernel boundary's eBPF programmes —
# so one string from a TOML file dragged the whole kernel half into the
# desktop's compile, and the image build failed on a stage with no
# `bpf-linker`. No test saw it; only building what ships did.
Environment=ALO_AGENT=alo

# The socket this person's clients connect to goes in a directory systemd makes
# and takes away. 0700: a desktop whose socket a second account could reach is
# a desktop that is not this person's.
RuntimeDirectory=alo-desktop
RuntimeDirectoryMode=0700

# **No capability at all.** The greeter's unit makes the same claim for the same
# reason: this process needs a seat and a socket, and saying so here is what
# makes it a fact rather than a sentence. A desktop is the largest surface on
# the machine and the one a person spends the day in front of; it holds nothing.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ExecStart=/usr/bin/alo-desktop

# **`on-failure`, and not `always`.** A desktop that died should come back. One
# that ended because the person signed out must not — restarting after that
# would draw a desktop over the sign-in screen `OnSuccess=` just put back.
Restart=on-failure
RestartSec=2

# **No `[Install]` section, on purpose.** Only `alo-sessiond` starts this, for a
# number it has checked; a desktop the machine could enable would start before
# anybody had signed in.
