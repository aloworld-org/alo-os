# alo OS: where the sign-in screen hands over the password the person just
# signed in with, so the system's own list holds it too (ADR 0150).
#
# The owner, 2026-11-09: "Keep both in step". polkit and `sudo` check the
# system's list, /etc/shadow; alo's sign-in checks its own (ADR 0024). After
# every sign-in that succeeded, the sign-in screen sends the person's number
# and password here, and `alo-keeping-the-system-password` writes it with
# `chpasswd`.
#
# **Only root may open it.** The sign-in screen runs as root with no
# capability at all (`alo-compositor.service`); being the socket's owner is
# what lets it in, and the program asks the kernel again before it reads a
# byte. Nobody else on the machine can hand a password to the system's list.
#
# **Accept=yes**: one connection, one short-lived process, one password.
[Unit]
Description=alo OS: where the sign-in screen keeps the system password in step
Documentation=https://github.com/aloworld-org/alo-os/blob/main/docs/decisions/0150-administrator-actions-ask-the-persons-password-each-time.md

[Socket]
ListenStream=/run/alo-keeping-the-system-password.socket
SocketUser=root
SocketGroup=root
SocketMode=0600
Accept=yes

[Install]
WantedBy=sockets.target
