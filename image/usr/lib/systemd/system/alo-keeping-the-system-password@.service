# alo OS: write the person's password into the system's list, once (ADR 0150).
#
# One instance per connection to `alo-keeping-the-system-password.socket`.
# It reads the person's number and password from the connection, gives them
# to `chpasswd -c YESCRYPT` on its standard input, writes whether it did to
# /run/alo-the-system-password/<number>, and answers one line.
#
# **One capability.** `CAP_DAC_OVERRIDE` is what lets root read and replace
# /etc/shadow, which is mode 0000. Measured once, on 2026-11-09 in the image
# under `setpriv`: with nothing else in the bounding set `chpasswd -c YESCRYPT`
# wrote a `$y$` hash, and with nothing at all it said "cannot open
# /etc/shadow". Not measured: the same under the base's SELinux policy on a
# booted machine.
[Unit]
Description=alo OS: keep the system password in step with the person's
Documentation=https://github.com/aloworld-org/alo-os/blob/main/docs/decisions/0150-administrator-actions-ask-the-persons-password-each-time.md
Requires=alo-keeping-the-system-password.socket

[Service]
Type=exec
ExecStart=/usr/libexec/alo-keeping-the-system-password
StandardInput=socket
StandardOutput=socket
StandardError=journal
User=root
Group=root
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_DAC_OVERRIDE
NoNewPrivileges=yes

# It writes in two places: /etc, where `chpasswd` replaces the list and takes
# its lock, and the one folder the desktop's sheet reads from.
ProtectSystem=strict
ReadWritePaths=/etc /run/alo-the-system-password
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
